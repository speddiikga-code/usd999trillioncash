# ─────────────────────────────────────────────────────────────────────────────
# ROOS environment configuration. Copy to .env (npm run dev does this for you and
# generates the two secrets). Full reference: ENVIRONMENT.md. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Secrets (REQUIRED in production) ─────────────────────────────────────────
# APP_SECRET signs tokens/HMACs; ENCRYPTION_KEY (32 bytes base64/hex, or a ≥32-char
# passphrase) encrypts stored provider keys with AES-256-GCM.
APP_SECRET=
ENCRYPTION_KEY=
# Set when rotating ENCRYPTION_KEY so old secrets stay readable (then run `npm run admin -- rotate-secrets`).
ENCRYPTION_KEY_PREVIOUS=

# ── Database & cache ─────────────────────────────────────────────────────────
# Started by `docker compose up -d`. If unreachable in development, ROOS falls back to
# embedded PGlite in ./data/pglite (single process — the worker then runs inside the API).
DATABASE_URL=postgres://roos:roos@localhost:5432/roos
DB_FALLBACK=pglite
REDIS_URL=redis://localhost:6379

# ── API / dashboard ──────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
# Public URL used in unsubscribe links, tracking snippets and generated MVPs.
API_PUBLIC_URL=http://localhost:4000
APP_URL=http://localhost:3000
TRUST_PROXY=false
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
TRACK_RATE_LIMIT_PER_MIN=600
# Seed the synthetic DEMO workspace on first start (clearly labelled; never mixed with real data).
SEED_DEMO=true
# "Explore the demo" button on the login page: a password-less, read-only (viewer) session that can
# only see the DEMO workspace. Defaults to true outside production and false in production.
# DEMO_GUEST_LOGIN=true

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
# all | scheduler | agents | comma-separated agent names (e.g. ResearchAgent,MarketAgent)
WORKER_ROLES=all
EXPERIMENT_EVAL_INTERVAL_MIN=15
DAILY_REPORT_HOUR_UTC=7
# Recurring discovery scans over your industries of interest (0 = off).
DISCOVERY_INTERVAL_MIN=0

# ── AI providers (all optional — without any, agents use labelled heuristics) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=
AI_PROVIDER_ORDER=anthropic,openai,google,ollama
AI_DAILY_BUDGET_USD=5
AI_MAX_COST_PER_TASK_USD=0.5
# Per-tier model overrides, e.g. ANTHROPIC_MODEL_DEEP=claude-opus-5
# ANTHROPIC_MODEL_FAST= / ANTHROPIC_MODEL_BALANCED= / ANTHROPIC_MODEL_DEEP=
# OPENAI_MODEL_FAST= ... GOOGLE_MODEL_DEEP= ... OLLAMA_MODEL=llama3.1

# ── Data connectors ──────────────────────────────────────────────────────────
# Identify your crawler honestly (Wikimedia and SEC require contact details).
HTTP_USER_AGENT=ROOS-Research-Bot/0.1 (+contact: you@example.com)
CONNECTOR_TIMEOUT_MS=15000
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
BRAVE_SEARCH_API_KEY=
SEC_USER_AGENT=
# Never enable in production: allows connectors to reach private networks.
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false

# ── Payments (verified revenue) ──────────────────────────────────────────────
# Use a Stripe RESTRICTED read-only key. Webhook endpoint: {API_PUBLIC_URL}/api/webhooks/stripe/<workspace-slug>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (outreach is approval-gated) ───────────────────────────────────────
# outbox = store only, never deliver (default). resend = deliver via Resend.
EMAIL_DRIVER=outbox
RESEND_API_KEY=
EMAIL_FROM=
# Required by anti-spam law before any commercial email can be sent.
COMPANY_POSTAL_ADDRESS=
EMAIL_DAILY_CAP=50

# ── Code sandbox & local deployments ─────────────────────────────────────────
# docker (recommended, required in production) | process (dev only; no network isolation) | disabled
SANDBOX_DRIVER=docker
SANDBOX_IMAGE=node:24-alpine
SANDBOX_TIMEOUT_MS=60000
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
PROJECTS_DIR=./data/projects
DEPLOY_PORT_START=5100
DEPLOY_PORT_END=5199

# ── Observability ────────────────────────────────────────────────────────────
# Optional: POST unhandled errors to this URL (Slack/Sentry relay…).
ERROR_WEBHOOK_URL=
# Optional bearer token for Prometheus scraping of /api/metrics.
METRICS_TOKEN=
